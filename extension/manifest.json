{
  "manifest_version": 3,
  "name": "Fingertips for Google Meet",
  "version": "1.2.0",
  "description": "Sign or type in Google Meet: Fingertips speaks your sentence into your microphone and shows it as a caption on your camera, so everyone hears and sees it.",
  "permissions": ["storage"],
  "host_permissions": ["https://66-135-26-183.sslip.io/*", "http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "bg.js" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
